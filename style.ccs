/* =========================================
   VARIABLES Y TEMAS
========================================= */

:root {
    --fondo: #f7f4fb;
    --tarjeta: #ffffff;
    --principal: #b9a7d9;
    --principal-suave: #eee8f7;
    --principal-oscuro: #8f78b5;

    --texto: #4f4a58;
    --texto-suave: #85808d;

    --borde: #e5dfed;
    --sombra: rgba(90, 75, 110, 0.08);

    --exito: #9bbfa8;
    --exito-suave: #edf6ef;

    --advertencia: #d5b477;
    --advertencia-suave: #fbf5e9;

    --peligro: #c9949c;
    --peligro-suave: #faf0f2;

    --radio-grande: 20px;
    --radio-mediano: 14px;
    --radio-pequeno: 10px;
}


/* =========================================
   TEMAS
========================================= */

body.tema-lila {
    --fondo: #f7f4fb;
    --tarjeta: #ffffff;
    --principal: #b9a7d9;
    --principal-suave: #eee8f7;
    --principal-oscuro: #8f78b5;
}

body.tema-verde {
    --fondo: #f3f8f4;
    --tarjeta: #ffffff;
    --principal: #a8c9b2;
    --principal-suave: #e8f2eb;
    --principal-oscuro: #719d7d;
}

body.tema-celeste {
    --fondo: #f2f7fa;
    --tarjeta: #ffffff;
    --principal: #a9c9dc;
    --principal-suave: #e7f1f7;
    --principal-oscuro: #719eb8;
}

body.tema-rosa {
    --fondo: #fbf4f6;
    --tarjeta: #ffffff;
    --principal: #ddb0bf;
    --principal-suave: #f7e7ed;
    --principal-oscuro: #b77d91;
}


/* =========================================
   GENERAL
========================================= */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    min-height: 100vh;

    background: var(--fondo);
    color: var(--texto);

    font-family:
        "Segoe UI",
        Arial,
        sans-serif;

    transition:
        background 0.3s ease,
        color 0.3s ease;
}

button,
input {
    font: inherit;
}

button {
    cursor: pointer;
}

.app {
    width: 100%;
    min-height: 100vh;
}


/* =========================================
   PANTALLAS
========================================= */

.pantalla {
    display: none;

    width: 100%;
    min-height: 100vh;

    padding: 40px 24px 70px;
}

.pantalla.activa {
    display: block;
}

.oculto {
    display: none !important;
}


/* =========================================
   ENCABEZADO PRINCIPAL
========================================= */

.encabezado-principal {
    max-width: 900px;
    margin: 0 auto 45px;

    text-align: center;
}

.encabezado-principal h1 {
    margin: 0 0 12px;

    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;

    color: var(--texto);
}

.encabezado-principal p {
    margin: 0;

    color: var(--texto-suave);

    font-size: 1.05rem;
}


/* =========================================
   CONTENEDORES
========================================= */

.contenido {
    width: 100%;
    max-width: 950px;

    margin: 0 auto;
}

.contenido-centrado {
    width: 100%;
    max-width: 600px;

    margin: 70px auto 0;

    text-align: center;
}

.contenido h1,
.contenido-centrado h1 {
    margin-bottom: 10px;

    font-size: clamp(1.7rem, 4vw, 2.3rem);
}

.descripcion {
    margin: 0 auto 30px;

    max-width: 650px;

    color: var(--texto-suave);
    line-height: 1.6;
}


/* =========================================
   BARRA SUPERIOR
========================================= */

.barra-superior {
    width: 100%;
    max-width: 1100px;

    margin: 0 auto 30px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
}

.barra-superior button {
    border: none;
    background: transparent;

    color: var(--principal-oscuro);

    font-weight: 600;

    padding: 8px 4px;

    transition: 0.2s ease;
}

.barra-superior button:hover {
    transform: translateX(-2px);
    opacity: 0.75;
}


/* =========================================
   SECCIONES
========================================= */

.seccion-ramos {
    max-width: 950px;
    margin: 0 auto;
}

.titulo-seccion {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 25px;
}

.titulo-seccion h2 {
    margin: 0;
    font-size: 1.5rem;
}


/* =========================================
   BOTONES
========================================= */

.boton-principal,
.boton-agregar,
.boton-secundario,
.boton-eliminar {
    border-radius: var(--radio-mediano);

    padding: 11px 18px;

    border: none;

    font-weight: 600;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
}

.boton-principal,
.boton-agregar {
    background: var(--principal);
    color: #ffffff;

    box-shadow:
        0 5px 15px var(--sombra);
}

.boton-principal:hover,
.boton-agregar:hover {
    background: var(--principal-oscuro);
    transform: translateY(-2px);
}

.boton-secundario {
    background: var(--principal-suave);
    color: var(--principal-oscuro);
}

.boton-secundario:hover {
    transform: translateY(-1px);
}

.boton-eliminar {
    background: var(--peligro-suave);
    color: var(--peligro);
}

.boton-eliminar:hover {
    background: #f5e3e7;
}


/* =========================================
   TARJETAS
========================================= */

.tarjeta {
    background: var(--tarjeta);

    border: 1px solid var(--borde);

    border-radius: var(--radio-grande);

    padding: 25px;

    margin-bottom: 20px;

    box-shadow:
        0 8px 25px var(--sombra);

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

.tarjeta h2 {
    margin-top: 0;
    margin-bottom: 20px;

    font-size: 1.15rem;
}

.tarjeta:hover {
    box-shadow:
        0 10px 30px var(--sombra);
}


/* =========================================
   RAMOS GUARDADOS
========================================= */

#lista-ramos {
    display: grid;

    grid-template-columns:
        repeat(auto-fit, minmax(250px, 1fr));

    gap: 18px;
}

.ramo-card {
    background: var(--tarjeta);

    border: 1px solid var(--borde);

    border-radius: var(--radio-grande);

    padding: 22px;

    box-shadow:
        0 7px 22px var(--sombra);

    cursor: pointer;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

.ramo-card:hover {
    transform: translateY(-3px);

    box-shadow:
        0 12px 28px var(--sombra);
}

.ramo-card h3 {
    margin: 0 0 10px;

    font-size: 1.15rem;
}

.ramo-card p {
    margin: 0;

    color: var(--texto-suave);
}

.ramo-promedio {
    margin-top: 18px;

    font-size: 1.5rem;
    font-weight: 700;

    color: var(--principal-oscuro);
}

.sin-ramos {
    background: var(--principal-suave);

    border: 1px dashed var(--principal);

    border-radius: var(--radio-grande);

    padding: 45px 25px;

    text-align: center;
}

.sin-ramos p {
    margin: 0 0 7px;

    font-weight: 600;
}

.sin-ramos span {
    color: var(--texto-suave);
}


/* =========================================
   OPCIONES
========================================= */

.opciones {
    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 16px;

    margin-top: 30px;
}

.opcion {
    padding: 22px;

    border-radius: var(--radio-grande);

    border: 1px solid var(--borde);

    background: var(--tarjeta);

    color: var(--texto);

    box-shadow:
        0 7px 20px var(--sombra);

    transition: 0.2s ease;
}

.opcion:hover {
    border-color: var(--principal);

    background: var(--principal-suave);

    transform: translateY(-2px);
}


/* =========================================
   FORMULARIOS
========================================= */

label {
    display: block;

    margin-bottom: 8px;

    font-weight: 600;

    color: var(--texto);
}

input[type="text"],
input[type="number"] {
    width: 100%;

    padding: 12px 14px;

    border-radius: var(--radio-pequeno);

    border: 1px solid var(--borde);

    background: #ffffff;

    color: var(--texto);

    outline: none;

    transition:
        border 0.2s ease,
        box-shadow 0.2s ease;
}

input:focus {
    border-color: var(--principal);

    box-shadow:
        0 0 0 3px var(--principal-suave);
}

.campo-porcentaje {
    margin-bottom: 20px;
}

.campo-con-unidad {
    display: flex;

    align-items: center;

    gap: 8px;
}

.campo-con-unidad input {
    flex: 1;
}

.campo-con-unidad span {
    color: var(--texto-suave);
}


/* =========================================
   EVALUACIONES
========================================= */

.bloque-evaluaciones {
    margin-bottom: 30px;
}

.bloque-evaluaciones h2 {
    margin-bottom: 15px;
}

.evaluacion-card {
    background: var(--tarjeta);

    border: 1px solid var(--borde);

    border-radius: var(--radio-mediano);

    padding: 18px;

    margin-bottom: 12px;

    box-shadow:
        0 5px 15px var(--sombra);
}

.evaluacion-card h3 {
    margin: 0 0 8px;
}

.evaluacion-info {
    display: flex;

    flex-wrap: wrap;

    gap: 10px;

    color: var(--texto-suave);
}

.pendiente {
    color: var(--advertencia);
    font-weight: 600;
}


/* =========================================
   RESULTADOS
========================================= */

.resultado-principal {
    text-align: center;
}

.promedio-grande {
    margin: 10px 0;

    font-size: 3.5rem;
    font-weight: 700;

    color: var(--principal-oscuro);
}

#estado-ramo {
    color: var(--texto-suave);
}

.resultado-examen,
#resultado-par,
#resultado-objetivo,
#resultado-aprobar {
    margin-top: 18px;

    line-height: 1.6;
}


/* =========================================
   RADIO Y CHECKBOX
========================================= */

.opciones-radio {
    display: flex;

    flex-direction: column;

    gap: 12px;

    margin: 15px 0;
}

.opciones-radio label,
.checkbox {
    display: flex;

    align-items: center;

    gap: 9px;

    font-weight: 500;

    cursor: pointer;
}

.opciones-radio input,
.checkbox input {
    accent-color: var(--principal-oscuro);
}


/* =========================================
   MENSAJES
========================================= */

.mensaje-validacion {
    margin: 12px 0;

    color: var(--texto-suave);

    font-size: 0.92rem;
}

.mensaje-exito {
    padding: 12px 15px;

    border-radius: var(--radio-pequeno);

    background: var(--exito-suave);

    color: #658b70;
}

.mensaje-advertencia {
    padding: 12px 15px;

    border-radius: var(--radio-pequeno);

    background: var(--advertencia-suave);

    color: #a27e3d;
}

.mensaje-peligro {
    padding: 12px 15px;

    border-radius: var(--radio-pequeno);

    background: var(--peligro-suave);

    color: #a66f78;
}


/* =========================================
   ZONA PELIGRO
========================================= */

.zona-peligro {
    margin-top: 40px;

    text-align: center;
}


/* =========================================
   MODALES
========================================= */

.modal {
    position: fixed;

    inset: 0;

    z-index: 1000;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(70, 60, 80, 0.25);

    backdrop-filter: blur(4px);
}

.modal-contenido {
    width: 100%;
    max-width: 500px;

    max-height: 90vh;

    overflow-y: auto;

    background: var(--tarjeta);

    border-radius: var(--radio-grande);

    padding: 28px;

    box-shadow:
        0 20px 60px rgba(60, 50, 70, 0.18);
}

.modal-contenido h2 {
    margin-top: 0;
}

.modal-contenido label {
    margin-top: 15px;
}

.modal-botones {
    display: flex;

    justify-content: flex-end;

    gap: 10px;

    margin-top: 25px;
}


/* =========================================
   RESPONSIVE
========================================= */

@media (max-width: 650px) {

    .pantalla {
        padding:
            25px
            16px
            50px;
    }

    .titulo-seccion {
        flex-direction: column;
        align-items: stretch;
    }

    .boton-agregar {
        width: 100%;
    }

    .opciones {
        grid-template-columns: 1fr;
    }

    .barra-superior {
        flex-wrap: wrap;
    }

    .tarjeta {
        padding: 20px;
    }

    .promedio-grande {
        font-size: 2.8rem;
    }

    .modal-contenido {
        padding: 22px;
    }

}
