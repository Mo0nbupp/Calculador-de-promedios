:root {
    --fondo: #faf7fc;
    --tarjeta: #ffffff;

    --principal: #c3b2df;
    --principal-hover: #aa94d0;
    --suave: #f0eaf8;

    --texto: #55505e;
    --texto-suave: #938e9a;

    --borde: #e7e0ee;

    --sombra: rgba(100, 85, 120, 0.10);

    --radio: 18px;
}


/* ================================
   TEMAS
================================ */

body.tema-lila {
    --fondo: #faf7fc;
    --principal: #c3b2df;
    --principal-hover: #aa94d0;
    --suave: #f0eaf8;
}

body.tema-verde {
    --fondo: #f5faf6;
    --principal: #afd0b8;
    --principal-hover: #91b99d;
    --suave: #e9f3eb;
}

body.tema-celeste {
    --fondo: #f4f9fc;
    --principal: #afd0e2;
    --principal-hover: #8fbdd3;
    --suave: #e8f2f7;
}

body.tema-rosa {
    --fondo: #fcf6f8;
    --principal: #dfb5c4;
    --principal-hover: #c995a8;
    --suave: #f7e9ee;
}


/* ================================
   GENERAL
================================ */

* {
    box-sizing: border-box;
}

body {
    margin: 0;

    min-height: 100vh;

    background: var(--fondo);

    color: var(--texto);

    font-family:
        "Segoe UI",
        Arial,
        sans-serif;

    transition:
        background 0.3s ease;
}

button,
input {
    font-family: inherit;
}


/* ================================
   PANTALLAS
================================ */

.pantalla {
    display: none;

    min-height: 100vh;

    padding: 40px 20px 70px;
}

.pantalla.activa {
    display: block;
}

.oculto {
    display: none !important;
}


/* ================================
   ENCABEZADOS
================================ */

.encabezado-principal {
    max-width: 850px;

    margin:
        0 auto
        50px;

    text-align: center;
}

.encabezado-principal h1 {
    margin: 0 0 12px;

    font-size: 42px;

    color: var(--texto);
}

.encabezado-principal p {
    margin: 0;

    color: var(--texto-suave);

    font-size: 17px;
}


.contenido {
    width: 100%;

    max-width: 900px;

    margin: auto;
}

.contenido-centrado {
    width: 100%;

    max-width: 600px;

    margin: 70px auto;

    text-align: center;
}


/* ================================
   BOTONES
================================ */

button {
    border: none;

    cursor: pointer;

    transition:
        transform 0.2s ease,
        background 0.2s ease,
        box-shadow 0.2s ease;
}


.boton-principal,
.boton-agregar {
    padding:
        12px 20px;

    border-radius: 13px;

    background: var(--principal);

    color: white;

    font-weight: 600;

    box-shadow:
        0 5px 15px var(--sombra);
}

.boton-principal:hover,
.boton-agregar:hover {
    background: var(--principal-hover);

    transform:
        translateY(-2px);
}


.boton-secundario {
    padding:
        11px 18px;

    border-radius: 12px;

    background: var(--suave);

    color: var(--principal-hover);

    font-weight: 600;
}

.boton-secundario:hover {
    transform:
        translateY(-2px);
}


/* ================================
   OPCIONES PRINCIPALES
================================ */

.opciones {
    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 20px;

    margin-top: 35px;
}


.opcion {
    min-height: 145px;

    padding: 28px;

    border:
        1px solid var(--borde);

    border-radius:
        var(--radio);

    background:
        var(--tarjeta);

    color: var(--texto);

    box-shadow:
        0 8px 25px var(--sombra);

    font-size: 18px;

    font-weight: 600;

    text-align: center;

    display: flex;

    align-items: center;

    justify-content: center;

    transition:
        transform 0.2s ease,
        background 0.2s ease,
        border 0.2s ease,
        box-shadow 0.2s ease;
}


.opcion:hover {
    background:
        var(--suave);

    border-color:
        var(--principal);

    transform:
        translateY(-4px);

    box-shadow:
        0 12px 30px var(--sombra);
}


/* ================================
   TARJETAS
================================ */

.tarjeta {
    padding: 25px;

    margin-bottom: 20px;

    border:
        1px solid var(--borde);

    border-radius:
        var(--radio);

    background:
        var(--tarjeta);

    box-shadow:
        0 8px 25px var(--sombra);
}


/* ================================
   FORMULARIOS
================================ */

label {
    display: block;

    margin:
        15px 0 7px;

    font-weight: 600;
}


input[type="text"],
input[type="number"] {
    width: 100%;

    padding:
        12px 14px;

    border:
        1px solid var(--borde);

    border-radius:
        11px;

    background:
        white;

    color:
        var(--texto);

    outline: none;
}


input[type="text"]:focus,
input[type="number"]:focus {
    border-color:
        var(--principal);

    box-shadow:
        0 0 0 3px var(--suave);
}


/* ================================
   RADIO
================================ */

.opciones-radio {
    display: flex;

    flex-direction: column;

    gap: 12px;

    margin-top: 20px;
}


.opciones-radio label,
.checkbox {
    display: flex;

    align-items: center;

    gap: 9px;

    padding:
        13px 15px;

    border:
        1px solid var(--borde);

    border-radius:
        12px;

    background:
        var(--tarjeta);

    cursor: pointer;

    transition:
        background 0.2s ease,
        border 0.2s ease;
}


.opciones-radio label:hover,
.checkbox:hover {
    background:
        var(--suave);

    border-color:
        var(--principal);
}


input[type="radio"],
input[type="checkbox"] {
    accent-color:
        var(--principal-hover);
}


/* ================================
   RAMOS
================================ */

#lista-ramos {
    display: grid;

    grid-template-columns:
        repeat(auto-fit, minmax(240px, 1fr));

    gap: 18px;
}


.ramo-card {
    padding: 22px;

    border:
        1px solid var(--borde);

    border-radius:
        var(--radio);

    background:
        var(--tarjeta);

    box-shadow:
        0 8px 25px var(--sombra);

    cursor: pointer;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}


.ramo-card:hover {
    transform:
        translateY(-4px);

    box-shadow:
        0 12px 30px var(--sombra);
}


.ramo-card h3 {
    margin:
        0 0 8px;
}


.ramo-card p {
    margin: 0;

    color:
        var(--texto-suave);
}


.ramo-promedio {
    margin-top: 15px;

    font-size: 25px;

    font-weight: 700;

    color:
        var(--principal-hover);
}


/* ================================
   EVALUACIONES
================================ */

.evaluacion-card {
    padding: 18px;

    margin-bottom: 12px;

    border:
        1px solid var(--borde);

    border-radius:
        14px;

    background:
        var(--tarjeta);

    box-shadow:
        0 5px 16px var(--sombra);
}


.evaluacion-card h3 {
    margin:
        0 0 8px;
}


.evaluacion-info {
    display: flex;

    flex-wrap: wrap;

    gap: 15px;

    color:
        var(--texto-suave);
}


.pendiente {
    color:
        #b79755;

    font-weight: 600;
}


/* ================================
   MENSAJES
================================ */

.mensaje-validacion {
    margin-top: 10px;

    color:
        var(--texto-suave);

    font-size: 14px;
}


.mensaje-exito {
    padding: 12px 15px;

    border-radius: 11px;

    background:
        #edf6ef;

    color:
        #668b70;
}


.mensaje-advertencia {
    padding: 12px 15px;

    border-radius: 11px;

    background:
        #faf4e7;

    color:
        #9b7b42;
}


.mensaje-peligro {
    padding: 12px 15px;

    border-radius: 11px;

    background:
        #faeef0;

    color:
        #a46f78;
}


/* ================================
   MODALES
================================ */

.modal {
    position: fixed;

    inset: 0;

    z-index: 1000;

    display: flex;

    align-items: center;

    justify-content: center;

    padding: 20px;

    background:
        rgba(65, 55, 75, 0.25);

    backdrop-filter:
        blur(5px);
}


.modal-contenido {
    width: 100%;

    max-width: 500px;

    max-height: 90vh;

    overflow-y: auto;

    padding: 28px;

    border-radius:
        20px;

    background:
        var(--tarjeta);

    box-shadow:
        0 20px 60px
        rgba(70, 60, 80, 0.18);
}


/* ================================
   ZONA DE BOTONES
================================ */

.modal-botones {
    display: flex;

    justify-content: flex-end;

    gap: 10px;

    margin-top: 25px;
}


/* ================================
   RESPONSIVE
================================ */

@media (max-width: 650px) {

    .pantalla {
        padding:
            25px 16px 50px;
    }

    .encabezado-principal h1 {
        font-size: 32px;
    }

    .opciones {
        grid-template-columns:
            1fr;
    }

}
